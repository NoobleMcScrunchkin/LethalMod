{
	"compilerOptions": {
		"target": "ES6",
		"allowJs": true,
		"module": "commonjs",
		"skipLibCheck": true,
		"esModuleInterop": true,
		"noImplicitAny": true,
		"sourceMap": true,
		"baseUrl": ".",
		"outDir": "dist",
		"moduleResolution": "node",
		"resolveJsonModule": true,
		"jsx": "react-jsx",
		"paths": {
			"@/*": ["src/*"]
		}
	},
	"include": ["*.ts", "*.js", "src/**/*", "prisma/seed.ts"],
	"exclude": ["node_modules"],
	"ts-node": {
		"require": ["tsconfig-paths/register"]
	},
	"tsc-alias": {
		"verbose": false,
		"resolveFullPaths": true
	}
}
